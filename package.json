
{
  "name": "book-bazar",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently -n WEB,API -c blue,green \"npm run dev --workspace @book-bazar/web\" \"npm run dev --workspace @book-bazar/api\"",
    "dev:web": "npm run dev --workspace @book-bazar/web",
    "dev:api": "npm run dev --workspace @book-bazar/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
